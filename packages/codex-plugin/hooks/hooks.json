{
  "description": "Inject queued Parle responsive delivery at supported Codex lifecycle boundaries.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PLUGIN_ROOT}\" && node hooks/parle-hook.mjs --scope codex-plugin",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PLUGIN_ROOT}\" && node hooks/parle-hook.mjs --scope codex-plugin",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PLUGIN_ROOT}\" && node hooks/parle-hook.mjs --scope codex-plugin",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PLUGIN_ROOT}\" && node hooks/parle-hook.mjs --scope codex-plugin",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery"
          }
        ]
      }
    ]
  }
}
