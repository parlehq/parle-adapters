{
  "description": "Correlate each Codex process to its Parle hook delivery bridge through the login-shell hook chain, bind the Codex thread so idle wake may queue a turn for it, restore bounded known-address context at session boundaries, and inject queued Parle responsive delivery at supported Codex lifecycle boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin --direct-parent --shell-launched --bind --known-address-context || printf '{}\\n'",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-parle-hook.cmd\" --scope codex-plugin --direct-parent --shell-launched --bind --known-address-context || echo {}\"",
            "timeout": 5,
            "statusMessage": "Restoring Parle known-address context",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin --direct-parent --shell-launched --bind || printf '{}\\n'",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-parle-hook.cmd\" --scope codex-plugin --direct-parent --shell-launched --bind || echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin --direct-parent --shell-launched || printf '{}\\n'",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-parle-hook.cmd\" --scope codex-plugin --direct-parent --shell-launched || echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin --direct-parent --shell-launched || printf '{}\\n'",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-parle-hook.cmd\" --scope codex-plugin --direct-parent --shell-launched || echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin --direct-parent --shell-launched || printf '{}\\n'",
            "commandWindows": "cmd /d /s /c \"\"%PLUGIN_ROOT%\\hooks\\run-parle-hook.cmd\" --scope codex-plugin --direct-parent --shell-launched || echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery"
          }
        ]
      }
    ]
  }
}
