{
  "description": "Inject queued Parle responsive delivery at supported Codex lifecycle boundaries.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin",
            "commandWindows": "cmd /d /s /c \"echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin",
            "commandWindows": "cmd /d /s /c \"echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin",
            "commandWindows": "cmd /d /s /c \"echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-parle-hook.sh\" --scope codex-plugin",
            "commandWindows": "cmd /d /s /c \"echo {}\"",
            "timeout": 5,
            "statusMessage": "Checking Parle delivery"
          }
        ]
      }
    ]
  }
}
