{
  "name": "@parlehq/command-code-adapter",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "commandcode": {
    "mods": [
      "./mods/parle.ts"
    ]
  },
  "scripts": {
    "build": "pnpm --filter @parlehq/mcp-server... build && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=mods/parle.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/check-mod-artifact.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@parlehq/agent-client": "workspace:*",
    "@parlehq/mcp-server": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
