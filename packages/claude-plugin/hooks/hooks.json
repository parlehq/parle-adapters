{
  "description": "Correlate each top-level Claude process to its Parle hook delivery bridge, restore bounded known-address context at session boundaries, and inject queued responsive delivery with its opaque reply route at supported Claude lifecycle boundaries.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/parle-hook.mjs\" --bind --direct-parent --known-address-context",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/parle-hook.mjs\" --bind --direct-parent",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/parle-hook.mjs\" --bind --direct-parent",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/parle-hook.mjs\" --bind --direct-parent",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/parle-hook.mjs\" --bind --direct-parent",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
